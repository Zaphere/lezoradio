# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# RSS Feed Configuration (verified working — optional overrides)
# Backend auto-replaces known dead URLs (times.co.sz, news24, etc.)
# Leave blank to use defaults below
RSS_FEEDS_ESWATINI=https://allafrica.com/tools/headlines/rdf/eswatini/headlines.rdf
RSS_FEEDS_SOUTH_AFRICA=https://www.iol.co.za/rss
RSS_FEEDS_CONGO=https://www.radiookapi.net/rss.xml
RSS_FEEDS_TRAFFIC=https://news.google.com/rss/search?q=traffic+Africa&hl=en-US&gl=US&ceid=US:en
RSS_FEEDS_TECH=https://techcrunch.com/feed/

# API server port (used by frontend RSS proxy)
PORT=3001
# Default: Every 15 minutes
INGESTION_SCHEDULE=*/15 * * * *
