# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=radiolezo
DB_USER=postgres
DB_PASSWORD=your-db-password

# RSS Feed Configuration (verified working — optional overrides)
RSS_FEEDS_ESWATINI=https://allafrica.com/tools/headlines/rdf/eswatini/headlines.rdf
RSS_FEEDS_SOUTH_AFRICA=https://www.iol.co.za/rss
RSS_FEEDS_CONGO=https://www.radiookapi.net/rss.xml
RSS_FEEDS_TRAFFIC=https://news.google.com/rss/search?q=traffic+Africa&hl=en-US&gl=US&ceid=US:en
RSS_FEEDS_TECH=https://techcrunch.com/feed/

# API server port
PORT=3001
INGESTION_SCHEDULE=*/15 * * * *

# ElevenLabs Text-to-Speech
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id

# ============================================================================
# Generic Provider Framework Configuration
# ============================================================================

USE_PROVIDER_FRAMEWORK=false

# RSS Provider
RSS_ENABLED=true
RSS_LANGUAGE=fr
RSS_SCHEDULE=*/15 * * * *

# ============================================================================
# LezoTraffic Partner API (v2)
# ============================================================================

LEZOTRAFFIC_ENABLED=false
LEZOTRAFFIC_BASE_URL=https://app.lezotraffic.com/api/v1
LEZOTRAFFIC_API_KEY=your-api-key
LEZOTRAFFIC_API_SECRET=your-api-secret

# API Client Settings
LEZOTRAFFIC_TIMEOUT=10000
LEZOTRAFFIC_MAX_RETRIES=3
LEZOTRAFFIC_RETRY_DELAY=1000

# Valid Endpoints (removed: alerts, traffic, congestion, roadworks, cities, statistics)
LEZOTRAFFIC_ENABLE_INCIDENTS=true
LEZOTRAFFIC_ENABLE_ACCIDENTS=true
LEZOTRAFFIC_ENABLE_ROUTES=true
LEZOTRAFFIC_ENABLE_TRANSPORTS=true
LEZOTRAFFIC_ENABLE_PROVINCES=true
LEZOTRAFFIC_ENABLE_DESTINATIONS=true
LEZOTRAFFIC_ENABLE_RADIOS=true

# Polling Intervals (cron expressions)
LEZOTRAFFIC_SCHEDULE=*/1 * * * *
LEZOTRAFFIC_SCHEDULE_INCIDENTS=*/1 * * * *
LEZOTRAFFIC_SCHEDULE_ACCIDENTS=*/1 * * * *
LEZOTRAFFIC_SCHEDULE_ROUTES=*/30 * * * *
LEZOTRAFFIC_SCHEDULE_TRANSPORTS=*/10 * * * *
LEZOTRAFFIC_SCHEDULE_PROVINCES=0 */24 * * *
LEZOTRAFFIC_SCHEDULE_DESTINATIONS=0 */24 * * *
LEZOTRAFFIC_SCHEDULE_RADIOS=0 */24 * * *

# Geographic Filters
LEZOTRAFFIC_COUNTRY=CD
LEZOTRAFFIC_PROVINCES=
LEZOTRAFFIC_CITIES=

# Data Retention (in hours)
LEZOTRAFFIC_RETENTION_INCIDENTS=72
LEZOTRAFFIC_RETENTION_ACCIDENTS=72
LEZOTRAFFIC_RETENTION_ROUTES=168
LEZOTRAFFIC_RETENTION_TRANSPORTS=168

# ============================================================================
# Future Providers
# ============================================================================
# WEATHER_ENABLED=false
# EMERGENCY_ENABLED=false
# TOURISM_ENABLED=false
