# ============================================================================
# Radio Lezo — Production Environment
# ============================================================================
# Copy this file to backend/.env and fill in your values.
# NEVER commit backend/.env to git.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4100
NODE_ENV=production

# ── Database (PostgreSQL on VPS) ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lezoradio
DB_USER=lezoradio_app
DB_PASSWORD=Password@123

# ── Supabase (if using Supabase features) ───────────────────────────────────
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-role-key

# ── ElevenLabs TTS ──────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Set to 'true' to test without spending API credits (generates sine waves)
# TTS_DRY_RUN=true

# ── RSS Feeds ───────────────────────────────────────────────────────────────
RSS_ENABLED=true
RSS_LANGUAGE=fr
RSS_SCHEDULE=*/15 * * * *
# RSS_FEEDS_CONGO=https://www.radiookapi.net/rss.xml

# ── Ingestion ───────────────────────────────────────────────────────────────
INGESTION_SCHEDULE=*/15 * * * *
EXPIRY_SCHEDULE=0 * * * *

# ── Provider Framework (optional) ───────────────────────────────────────────
USE_PROVIDER_FRAMEWORK=false

# ── LezoTraffic (optional) ──────────────────────────────────────────────────
# LEZOTRAFFIC_ENABLED=false
# LEZOTRAFFIC_API_KEY=your-api-key
# LEZOTRAFFIC_API_SECRET=your-api-secret
